2. 存储过程：增加员工工资
plsql
复制代码
CREATE OR REPLACE PROCEDURE increase_employee_salary (
    p_employee_id IN employees.employee_id%TYPE,
    p_increase_amount IN NUMBER
) IS
    v_old_salary employees.salary%TYPE;
    v_new_salary employees.salary%TYPE;
BEGIN
    -- 获取旧工资
    SELECT salary INTO v_old_salary FROM employees WHERE employee_id = p_employee_id;
    
    -- 计算新工资
    v_new_salary := v_old_salary + p_increase_amount;
    
    -- 更新工资
    UPDATE employees SET salary = v_new_salary WHERE employee_id = p_employee_id;
    
    -- 插入工资历史记录
    INSERT INTO salary_history (history_id, employee_id, old_salary, new_salary, change_date)
    VALUES (salary_history_seq.NEXTVAL, p_employee_id, v_old_salary, v_new_salary, SYSDATE);
    
    DBMS_OUTPUT.PUT_LINE('员工工资已增加。');
    
    COMMIT;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('没有找到对应的员工。');
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('发生错误：' || SQLERRM);
        ROLLBACK;
END;
/
